# Copy this file to ".env" and fill in your real values. Never commit ".env" itself.

PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/backend_mvc

# JWT secret used to sign tokens
JWT_SECRET=change_this_to_a_long_random_string

# Load balancer port (only used by loadBalancer.js)
LB_PORT=8080
